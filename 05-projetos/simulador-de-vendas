        "print()\n",
        "\n",
        "# Ação 5\n",
        "\n",
        "dias = list(vendas_por_dia.keys()) #Cria uma lista com os dias\n",
        "totais_por_dia = [sum(vendas_por_dia[dia].values()) for dia in dias] #Soma os valores por dia de todas as empresas\n",
