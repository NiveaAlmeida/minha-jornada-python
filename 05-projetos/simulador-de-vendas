        "import matplotlib.pyplot as plt\n",
        "\n",
        "dados_de_vendas = {\n",
        "    'Empresa A': [],\n",
        "    'Empresa B': [],\n",
        "    'Empresa C': [],\n",
        "    'Empresa D': []\n",
        "}\n",
        "\n",
        "total = 0.0\n",
        "mes = np.random.choice([30, 31])\n",
        "vendas_por_dia = {dia: {} for dia in range(1, mes+1)} # Cria o dicionário com as vendas por dia, no mês\n",
