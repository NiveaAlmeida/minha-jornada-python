        "\n",
        "plt.plot(dias, totais_por_dia, marker='o')\n",
        "plt.title(\"Vendas totais por dia\")\n",
        "plt.xlabel(\"Dias\")\n",
        "plt.ylabel(\"Vendas\")\n",
        "plt.grid(True)\n",
        "plt.show()"
